# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
# Optional TLS, for a worker on another cluster reaching Temporal through a Route.
# Plain gRPC when unset (every client inside the hub). Set the CA (PEM path) to
# turn TLS on; verification is never switched off. The server name is the one to
# verify and send as SNI when it differs from TEMPORAL_HOST's host.
# TEMPORAL_TLS_CA=/etc/temporal-ca/ca.crt
# TEMPORAL_TLS_SERVER_NAME=temporal.apps.example.com

# --- Segments Manager (GETs are public; mutating calls need the bearer token) ---
SEGMENTS_MANAGER_URL=http://localhost:8000
SEGMENTS_MANAGER_API_TOKEN=dev-token

# --- the day1 values repo (cluster-lifecycle, upgrade-gitops, vm-lifecycle) ---
# Where cluster files live: sites/<site>/mces/<mce>/hostedClusters/<cluster>.yaml.
# provision-cluster reads main and pushes a branch per cluster
# (provision-cluster/<cluster>); upgrade-gitops pushes main; create-vm reads.
# The clusters root ("sites"), the branch scheme and each writer's committer
# identity are hardcoded, not configured. Must be https:// (checked at worker
# startup): the token is injected into https clone URLs only.
DAY1_REPO_URL=https://github.com/team-redbull/gitops-day1-platform-config.git
# Token with push rights to the values repo — and, for provision-cluster, API
# rights on its git provider (GitLab: `api` + `write_repository`; GitHub: `repo`)
# to open the merge request. Never logged — scrubbed from every git command echo
# and error message. The shared `redbull-git-token` Secret in the cluster.
DAY1_GIT_TOKEN=dev-token
# provision-cluster's limb reads the same token as REDBULL_GIT_TOKEN, the key of the
# air-gap's `redbull-git-token` Secret (passed through unrenamed); DAY1_GIT_TOKEN above is
# accepted too, and REDBULL_GIT_TOKEN wins when both are set.
# REDBULL_GIT_TOKEN=dev-token

# --- provision-cluster: the day1 repo's git provider ---
# Which API opens the merge request from provision-cluster/<cluster> to main:
# `gitlab` (production, the air-gapped GitLab — a merge request with
# remove_source_branch) or `github` (dev — a pull request; delete-on-merge is a
# repository setting there). REQUIRED, no default: the two APIs share nothing.
DAY1_GIT_PROVIDER=github

# --- provision-cluster: DHCP scope policy ---
# The ONE DHCP policy knob, PER SEGMENT TYPE: last-octet ranges excluded from
# distribution. They are the only thing written to the cluster file besides the
# network — startRange/endRange are NOT emitted, so the DHCP API derives
# .1-.253 and these exclusions carve the ends back out of it. /24 segments only
# — any other prefix fails the run with UnsupportedSegmentPrefix. Keyed by type
# because each type reserves a different slice of its /24. A type that is NOT
# LISTED excludes nothing — its scope distributes the whole derived range — so
# list a type only when it reserves something. HC is REQUIRED (the only type
# provision-cluster allocates, where a forgotten policy would quietly hand out
# reserved addresses); other types may be listed ahead of the code that
# allocates them and are validated the same way. (Was segment-lifecycle's until
# provision-cluster took over the cluster file, 2026-11-11.)
DHCP_EXCLUSION_OCTET_RANGES={"HC": [[1, 10], [241, 254]]}

# --- provision-cluster: the day2 sig repos ---
# After a person merges the cluster file, the run registers the cluster in every
# sig the value layers list under day2.copy_to_sigs: the folder
# sites/<site>/<env>/mces/<mce>/<cluster>/ (with a .gitkeep) on that sig repo's
# default branch. The repo URL is this template with {sig} filled in
# (production: one GitLab project per sig, https://<gitlab>/redbull/gitops-day2-prod/sigs/{sig}.git,
# tree at the root; dev: the one GitHub repo below, tree under sigs/<sig>), the
# path prefix before sites/ the second one ("" for the root). {sig} must appear
# in one of them. https:// only.
DAY2_SIG_REPO_URL_TEMPLATE=https://github.com/team-redbull/gitops-day2-prod.git
DAY2_SIG_PATH_TEMPLATE=sigs/{sig}
# The token the sig repos are pushed with; EMPTY = DAY1_GIT_TOKEN. The chart never
# sets it: redbull-git-token is the group token and covers both. The push goes to the default branch, bypassing
# the sig's merge-request lint by design.
DAY2_GIT_TOKEN=

# --- server-lifecycle: which MCE this worker serves ---
# REQUIRED, no default: the worker fails to start without it. It names the
# activity queue this worker polls (server-lifecycle-activity-<MCE_CLUSTER>), so
# it MUST equal the `mce_cluster` callers put in the request body. That is the
# whole cross-cluster mechanism: the brain on the hub picks the target cluster by
# which queue it dispatches to, and the worker inside that MCE writes to its own
# API server as its own ServiceAccount. One deployment of this worker per MCE.
MCE_CLUSTER=ocp4-mce-bat-yam-01

# --- server-lifecycle: server-scan (the inventory platform) ---
# Base URL INCLUDING /api/v1. add-server-to-mce reads GET /servers/available,
# which returns unclaimed, healthy, reachable, unreserved servers and
# live-rechecks each one it hands back, then takes and releases the install
# lock on the one it chose (POST/DELETE /servers/{id}/reservation).
SERVER_SCAN_URL=http://localhost:8080/api/v1
# An ADMIN token — the reservation endpoints are mutations, and a viewer token
# fails every run with ServerScanAuthError. May be left empty: server-scan's
# auth is disabled by default and auto-admits every caller.
SERVER_SCAN_API_TOKEN=

# --- server-lifecycle: BMC credentials, per vendor ---
# What Ironic uses to drive the BMC. server-scan deliberately never holds
# these (it returns inventory data only), so they come from this worker's own
# Secret. Only the vendors you actually install need a pair; a server whose
# vendor has none fails its run with BmcCredentialsMissingError rather than
# producing a BareMetalHost that cannot authenticate.
HP_BMC_USERNAME=
HP_BMC_PASSWORD=
DELL_BMC_USERNAME=
DELL_BMC_PASSWORD=
CISCO_BMC_USERNAME=
CISCO_BMC_PASSWORD=
INTERSIGHT_BMC_USERNAME=
INTERSIGHT_BMC_PASSWORD=

# --- server-lifecycle: PXE map (IPMI servers only) ---
# An IPMI BMC (a UCS-managed Cisco blade) has no virtual media, so the host
# PXE-boots. Before its BareMetalHost is created, add-server-to-mce points the
# BMH's boot MAC (/pxe-map/<mac>) at the InfraEnv's boot entry
# (/pxe-map/<mce_cluster>/<infra_env>, published once the discovery image
# includes the host's NMStateConfig) on the PXE VM of the MCE inventory
# segment's site. The PXE VM's pxe-map-api must support boot entries. Site (as the Segments
# Manager names it) -> that VM's base URL. Optional: only IPMI installs read it,
# and an IPMI server at an unlisted site is skipped with PxeSiteNotConfiguredError.
PXE_MAP_URLS={"bat-yam": "http://pxe-vm.bat-yam.example:8080"}
PXE_MAP_TOKEN=

# --- server-provisioning: OpenManage Enterprise ---
# provision-dell-server discovers each new Dell here and deploys its template.
# https:// only (checked at worker startup); the client appends /api.
OME_URL=https://ome.example
OME_USERNAME=
OME_PASSWORD=

# --- server-provisioning: iDRAC root ---
# Root (user 2) is the ONLY iDRAC account touched; the OME account on the iDRAC
# is never read or changed. IDRAC_ROOT_PASSWORD is the one the template
# enforces and is tried first; IDRAC_FACTORY_PASSWORDS (a JSON list, at most 2)
# are what a server may arrive with, tried next in order. iDRAC9 blocks an
# address after 3 failed logins, which is why the list is capped.
IDRAC_USERNAME=root
IDRAC_ROOT_PASSWORD=
IDRAC_FACTORY_PASSWORDS=["<factory-password-1>", "<factory-password-2>"]

# --- server-provisioning: templates ---
# Redfish model -> iDRAC firmware version -> OME template name. A machine whose
# (model, firmware) is not listed fails with TemplateNotConfiguredError.
DELL_TEMPLATES={"PowerEdge R660": {"7.10.70.00": "ocp-r660-idrac-7.10.70.00"}}

# --- server-provisioning: the naming service ---
# Renames the OME profile to ocp-dell-<model>-<region>-<cores>c-<mem>gb-<disk>tb-<tag>.
# The request it gets is built in activities/server_provisioning/server_namer.py.
SERVER_NAMER_URL=http://localhost:9000/rename
SERVER_NAMER_API_TOKEN=
# SERVER_SCAN_URL / SERVER_SCAN_API_TOKEN above are read by this worker too.

# --- release-segment: the DHCP scope API (dhcp_scope_manager) ---
# release-segment checks whether a released cluster's DHCP scope survived the
# Argo CD cascade (GET, anonymous) and deletes it if so (DELETE, bearer token).
# The only write this worker makes there; Crossplane stays the only
# creator/updater of scopes.
DHCP_API_URL=http://localhost:8090
# A COPY of the DHCP API's own token (redbull-platform:
# gitops/charts/dhcp-scope-manager/charts/dhcp-api-token/values.yaml). Rotate
# both together — a stale copy fails every release with DhcpApiAuthError.
DHCP_API_TOKEN=dev-token

# --- cluster-upgrade (per-MCE cluster limb, cluster-upgrade-worker) ---
# MCE_CLUSTER above names its queue too (cluster-upgrade-activity-<MCE_CLUSTER>).
# Where the hosted clusters' Argo CD Applications live (the hcAppset's
# namespace), and which source of a multi-source Application holds the day1
# values (the hcAppset's `ref: values`): a day1 commit is synced in that
# source, the chart source keeps its revision.
ARGO_NAMESPACE=openshift-gitops
ARGO_VALUES_REF=values

# --- cluster-upgrade (hub limb, upgrade-gitops-worker) ---
# DAY1_REPO_URL and DAY1_GIT_TOKEN above serve it too: it reads the rules and
# cluster files at day1 main and pushes each step there. DAY2_GIT_TOKEN above is
# read by this limb too (its day2 read; empty = check 4 not checked).
# Run in the clone before every push (D3), e.g. production's
# `python3 scripts/validate_all_clusters.py` (the dev copy has none); empty =
# pushed without it, logged.
DAY1_VALIDATE_COMMAND=
# Optional: empty = check 4 (day2 version layers) not checked, said in the result.
DAY2_REPO_URL=
DAY2_GIT_TOKEN=
# Optional: empty = agent verdicts stay in the run's history, nothing is pushed.
BRAIN_REPO_URL=
BRAIN_GIT_TOKEN=
# A container auth file (.dockerconfigjson shape) for the release registry and
# oc adm release info; empty = anonymous (quay.io's ocp-release allows it, its
# payload repository does not).
REGISTRY_AUTH_FILE=
# Off only for a registry whose CA cannot be mounted (the internal mirror).
REGISTRY_TLS_VERIFY=true

# --- cluster-upgrade (per-MCE agent limb, upgrade-agent-worker) ---
# MCE_CLUSTER above names its queue too (upgrade-agent-activity-<MCE_CLUSTER>).
# The worker holds no Kubernetes credential: it POSTs each invocation to the
# upgrade agent service in the same MCE (an agent-sandbox Sandbox behind a
# Service). REQUIRED, http:// or https:// (checked at worker startup).
UPGRADE_AGENT_URL=http://upgrade-agent.upgrade-agent.svc:8080
# Optional: the bearer token, when the service asks for one (from a Secret).
UPGRADE_AGENT_TOKEN=

# --- vm-lifecycle (hub limb, vm-lifecycle-worker): create-vm ---
# DAY1_REPO_URL and DAY1_GIT_TOKEN above serve it too: it lists a zone's KubeVirt
# clusters from the seed folder sites/<site>/mces/ocp4-seed-<site>-<zone>/hostedClusters/
# at day1 main (read only). The worker holds no Kubernetes credential: each
# KubeVirt cluster is reached through its two agents behind Routes. REQUIRED,
# http:// or https://, rendered per cluster: {cluster} = the day1 clusterName,
# {name} = the day1 file's stem, {hosted_cluster} = openshift-<clusterName>,
# {site}, {zone}. Which apps domain a cluster has is the template's to say.
KV_CAPACITY_URL_TEMPLATE=https://kv-capacity.apps.{cluster}.example.net
KV_VM_API_URL_TEMPLATE=https://kv-vm-api.apps.{cluster}.example.net
# One fleet bearer token per agent (from Secrets); empty sends no header.
KV_CAPACITY_TOKEN=
KV_VM_API_TOKEN=
# A PEM file the agents' Route certificates are verified against. EMPTY = NOT
# VERIFIED (the operator's decision: the Routes carry the ingress wildcard
# certificate, whose CA the image cannot carry) — the one place TLS verification
# is off by default.
KV_AGENT_CA=
# Our placement policy: the share of every KubeVirt cluster's schedulable
# allocatable that must stay free AFTER placing the VM, on CPU and on memory,
# per cluster (docs/design/kubevirt-vm-placement.md). REQUIRED, 0..90.
HEADROOM_BUFFER_PERCENT=30
# The first three octets of every VM's MAC (the run draws the other three):
# locally administered and unicast — the first octet's low bits are `10`
# (02, 06, 0a, 0e, 12, …). REQUIRED.
VM_MAC_PREFIX=02:a1:b2
