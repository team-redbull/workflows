# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Segments Manager (GETs are public; mutating calls need the bearer token) ---
SEGMENTS_MANAGER_URL=http://localhost:8000
SEGMENTS_MANAGER_API_TOKEN=dev-token

# --- allocate-segment: the day1 values repo (cluster values files) ---
# The workflow appends the vlanId + dhcp_values block to
# sites/<site>/mces/<mce>/hostedClusters/<cluster>.yaml and pushes. The clusters
# root ("sites") and the committer identity are hardcoded in values_repo.py, not
# configured. There is no branch setting: every run names its branch
# (values_branch — the day1 pipeline's own branch); Argo CD picks the block up
# when a human merges that branch to main.
DAY1_REPO_URL=https://github.com/team-redbull/gitops-day1-platform-config.git
# Token with push rights to the values repo. Never logged — scrubbed from every
# git command echo and error message.
DAY1_GIT_TOKEN=dev-token

# --- allocate-segment: DHCP scope policy ---
# The ONE DHCP policy knob, PER SEGMENT TYPE: last-octet ranges excluded from
# distribution. They are the only thing written to the cluster values file
# besides the network — startRange/endRange are NOT emitted, so the DHCP API
# derives .1-.253 and these exclusions carve the ends back out of it. /24
# segments only — any other prefix fails the run with UnsupportedSegmentPrefix.
# Keyed by type because each type reserves a different slice of its /24. A type
# that is NOT LISTED excludes nothing — its scope distributes the whole derived
# range — so list a type only when it reserves something. HC is REQUIRED (the
# only type allocate-segment supports, where a forgotten policy would quietly
# hand out reserved addresses); other types may be listed ahead of the code
# that allocates them and are validated the same way.
DHCP_EXCLUSION_OCTET_RANGES={"HC": [[1, 10], [241, 254]]}
