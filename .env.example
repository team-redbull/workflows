# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Segments Manager (GETs are public; mutating calls need the bearer token) ---
SEGMENTS_MANAGER_URL=http://localhost:8000
SEGMENTS_MANAGER_API_TOKEN=dev-token

# --- next connectivity service (black box in prod; dev/mock-segment-connectivity locally) ---
NEXT_URL=http://localhost:9000
# URI paths are configurable because the air-gapped prod paths may differ:
NEXT_TOKEN_RENEWAL_URI=/token-renewal-uri
NEXT_OPEN_RULES_URI=/open-rules-uri
NEXT_CHECK_STATUS_URI=/check-request-status
# The AD group next attributes every open-rules request to (payload `ad_groups`).
# A group in next's own directory — differs per environment.
NEXT_GROUP=dev-group
# Seconds between polls of a submitted request's status. Fast locally against
# the mock; prod should use a much larger value (e.g. 600) against the real,
# human-driven approval.
NEXT_CHECKING_REQUEST_INTERVAL_SECONDS=15

# --- our payload policy (not next's config) ---
DOMAIN=domain1
# Port policy per rule direction — JSON per protocol: {"tcp": ["PORT", "START-END"], "udp": [...]}
# Validated fail-fast at activity-worker startup. In-cluster this comes from the ConfigMap.
PORTS_HC_TO_MCE={"tcp": ["30000-32767"], "udp": ["9000"]}
PORTS_MCE_TO_HC={"tcp": ["6443", "30000-32767"]}
PORTS_INVENTORY_TO_MCE={"tcp": ["30000-32767"], "udp": ["9000"]}
PORTS_MCE_TO_INVENTORY={"tcp": ["6443", "30000-32767"]}
# No PXE profiles: PXE segments exist in the Segments Manager, but connectivity
# is deliberately not opened for them, and these profiles ARE the peering
# topology — a PXE profile here would make every MCE run open MCE<->PXE rules.
# The shared site topology. Defined ONCE in redbull-platform
# (gitops/values/<env>.yaml, key `siteNetworks`) and rendered into both this
# service's ConfigMap and the Segments Manager's — which is what guarantees the
# two agree on the site list. This service reads only the BMC keys: every MCE
# segment opens rules in BOTH DIRECTIONS against BOTH of its site's static BMC
# networks, which are not tracked by the Segments Manager. There are two
# because server out-of-band management sits on a different /16 per hardware
# vendor (`dell-bmc`, `cisco-bmc`), and an MCE manages whatever hardware sits
# under it — nothing at segment level says which vendor that is. A site may
# have only one vendor's hardware, so a site carries `dell-bmc`, `cisco-bmc`,
# or both — site3 below is Dell-only. AT LEAST ONE is REQUIRED: a site with
# neither, or with a misspelt key (`dell-bcm`, or the pre-split `bmc`),
# crash-loops the activity worker at startup rather than silently opening
# connectivity for fewer vendors than the site actually has. `pool` belongs to
# the Segments Manager and is ignored here.
SITE_NETWORKS={"site1": {"pool": "192.10.0.0/16", "dell-bmc": "10.50.0.0/16", "cisco-bmc": "10.60.0.0/16"}, "site2": {"pool": "193.51.0.0/16", "dell-bmc": "10.51.0.0/16", "cisco-bmc": "10.61.0.0/16"}, "site3": {"pool": "194.52.0.0/16", "dell-bmc": "10.52.0.0/16"}}
# ONE profile for every MCE<->BMC request (each vendor, both directions):
# the same IPMI ports whichever way the rule runs. It keeps the MCE_TO_BMC name
# because renaming it would mean shipping a new ConfigMap key ahead of the image.
PORTS_MCE_TO_BMC={"tcp": ["623"], "udp": ["623"]}

# --- allocate-segment: the day1 values repo (cluster values files) ---
# The workflow appends the vlanId + dhcp_values block to
# sites/<site>/mces/<mce>/hostedClusters/<cluster>.yaml and pushes; Argo CD +
# Crossplane turn that into a live DHCP scope. The clusters root ("sites") and
# the committer identity are hardcoded in values_repo.py, not configured.
DAY1_REPO_URL=https://github.com/team-redbull/gitops-day1-platform-config.git
DAY1_BRANCH=main
# Token with push rights to the values repo. Never logged — scrubbed from every
# git command echo and error message.
DAY1_GIT_TOKEN=dev-token

# --- allocate-segment: DHCP scope policy + the DHCP API ---
# The ONE DHCP policy knob: last-octet ranges excluded from distribution.
# startRange/endRange are DERIVED (first/last non-excluded host octet), so the
# range and the exclusions can never contradict. /24 segments only — any other
# prefix fails the run with UnsupportedSegmentPrefix.
DHCP_EXCLUSION_OCTET_RANGES=[[1, 10], [241, 254]]
# The DHCP scope API — read-only here: the workflow polls GET /api/v1/scopes/
# {network} until Crossplane has created the scope; it never writes one. No token
# setting: that API leaves its scope GETs unauthenticated so this poll needs no
# credential of its own. Writes there are still authenticated.
DHCP_API_URL=http://localhost:8090

# --- dev/mock-segment-connectivity only: simulated human-approval delay ---
#COMPLETION_DELAY_SECONDS=60
